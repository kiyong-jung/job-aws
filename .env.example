# .env 로 복사해 키를 채운다: cp .env.example .env   (.env 는 git 에 올리지 않는다)
# 모델 호출은 둘 중 하나. ANTHROPIC_API_KEY 가 있으면 Anthropic API, 없으면 AWS Bedrock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Bedrock 을 쓸 때 (aws sso login --profile <이름> 먼저)
AWS_PROFILE=
AWS_REGION=ap-northeast-2
LLM_BACKEND=
BEDROCK_MOCK=0

# 선택: 프로젝트 DB 를 처음부터 다시 모을 때만 (GitHub API 한도를 올린다)
GITHUB_TOKEN=
